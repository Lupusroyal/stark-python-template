# ==========================================
# Application
# ==========================================
APP_NAME=Stark API
APP_VERSION=1.0.0
APP_ENV=development

DEBUG=false

# ==========================================
# Database
# ==========================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/stark_db

# ==========================================
# Authentication
# ==========================================
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_64_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# CORS & Hosts
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ==========================================
# Ports
# ==========================================
API_PORT=8000
POSTGRES_PORT=5432
